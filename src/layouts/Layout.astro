---
import { Font, Image } from "astro:assets";
import flagOrpheusLeft from "@/assets/flag-orpheus-left.svg";
import "@/styles/global.css"

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "mini | Hack Club",
	description = "Build a small website and earn prizes from Hack Club.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#fffaf3" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL('/og-image.png', Astro.site).href} />
		<Font cssVariable="--font-nunito-sans" />
		<Font cssVariable="--font-darumadrop-one" />
		<Font cssVariable="--font-pixelify-sans" />
		<title>{title}</title>
	</head>
<body>
		<a class="hc-flag" href="https://hackclub.com" aria-label="Hack Club">
			<Image src={flagOrpheusLeft} alt="Hack Club" />
		</a>
		<slot />
	</body>
</html>
